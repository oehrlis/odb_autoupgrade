# ------------------------------------------------------------------------------
# OraDBA - Oracle Database Infrastructure and Security, 5630 Muri, Switzerland
# ------------------------------------------------------------------------------
# Name.......: os-fixed-gid.env
# Purpose....: Example site group profile using OS groups with fixed GIDs.
#              This file is an EXAMPLE - it is NOT loaded automatically.
#
#              To use fixed-GID group names instead of the Oracle Database
#              Preinstallation RPM defaults (dba, oper, backupdba, etc.),
#              copy the AU_GROUP_* lines you need into your site's
#              autoupgrade.env (or AUTOUPGRADE_ENV_FILE).
#
#              The 'os*' group names with fixed GIDs are a site convention,
#              not an Oracle requirement. Group creation with the GIDs listed
#              below is handled by the oradba-ansible collection (oradba.automation).
#
#              GIDs: AutoUpgrade only needs the group names. The fixed GIDs of an
#              os* site convention are site-specific (taken from a reference host)
#              and differ from the Preinstallation RPM GIDs (oinstall 54321,
#              dba 54322, oper 54323, backupdba 54324, dgdba 54325, kmdba 54326,
#              racdba 54330). Record your own GIDs in the site configuration of
#              the group creation (oradba-ansible), not here.
#
# Usage.....: Copy into autoupgrade.env or AUTOUPGRADE_ENV_FILE, e.g.:
#               AU_GROUP_OSDBA=osdba
#               AU_GROUP_OSOPER=osoper
#               ...
# Reference.: doc/design.md - Edition and OS groups
#             https://docs.oracle.com/en/database/oracle/oracle-database/21/ladbi/
# License...: Apache License Version 2.0
# ------------------------------------------------------------------------------

# Example site convention: os* group names (GIDs are site-specific, see above)
AU_GROUP_OSDBA=osdba
AU_GROUP_OSOPER=osoper
AU_GROUP_OSBACKUPDBA=osbackupdba
AU_GROUP_OSDGDBA=osdgdba
AU_GROUP_OSKMDBA=oskmdba
AU_GROUP_OSRACDBA=osracdba
# Inventory group: set in /etc/oraInst.loc or with AU_INVENTORY_GROUP
