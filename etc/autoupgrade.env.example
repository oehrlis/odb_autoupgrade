# ------------------------------------------------------------------------------
# etc/autoupgrade.env.example - site settings for bin/au_run.sh
#
# Copy this file to etc/autoupgrade.env and adapt to the local environment.
# autoupgrade.env is sourced with "set -a" so every variable is exported.
#
# Precedence: environment of the caller > this file > built-in defaults, e.g.
#   AUTOUPGRADE_PROXY=none bin/au_run.sh ... overrides a proxy set here.
#
# The file is sourced as shell code: it must be owned by the user running the
# scripts and must not be group or world writable, otherwise it is refused.
# autoupgrade.env is ignored by git (.gitignore) - never commit site settings.
# Never store passwords or secrets here; use the 1Password CLI:
#   AUTOUPGRADE_TRUSTSTORE_PASS=$(op read "op://Vault/Item/field")
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Patch definition and template variables (etc/au_download.cfg,
# etc/au_create_home.cfg, etc/au_deploy.cfg)
# ------------------------------------------------------------------------------
# AU_PATCH is the single source of truth for download, create_home and deploy.
# Order: caller > this file > ${AU_DOWNLOAD_FOLDER}/au_patch.env > RECOMMENDED.
# RECOMMENDED = RU, OPATCH, DPBP, OJVM, AU, MRP (no JDK). Pin a quarter with e.g.
# RU:19.32,OPATCH,OJVM,DPBP,MRP. Do not combine RECOMMENDED with RU:x.y.
# CSPU is rejected on Linux for 19c - use MRP.
#
#AU_PATCH=RECOMMENDED
#AU_PATCH="RU:19.32,OPATCH,OJVM,DPBP,MRP"

# Defaults shown; change only if needed.
#AU_TARGET_VERSION=19
#AU_PLATFORM=LINUX.X64
#AU_GOLD_IMAGE=NO # NO | YES (fail if Update Advisor unusable) | AUTO | ALL
#AU_LOG_DIR=${AUTOUPGRADE_BASE}/logs
#AU_KEYSTORE=${AUTOUPGRADE_BASE}/keystore
#AU_DOWNLOAD_FOLDER=${AUTOUPGRADE_BASE}/patches

# Per run (no defaults - the config check aborts if they are missing):
#AU_SOURCE_HOME=/u00/app/oracle/product/19.31.0.0
#AU_TARGET_HOME=/u00/app/oracle/product/19.32.0.0
#AU_SID=ORCL

# ------------------------------------------------------------------------------
# Proxy settings
# ------------------------------------------------------------------------------
# Outbound proxy for AutoUpgrade to reach MOS / Oracle REST endpoints.
# Supported formats:
#   http://proxy.example.com:3128
#   https://proxy.example.com:3128
#   http://proxy.example.com           (port defaults to 80)
# Use "none" to disable proxy even when https_proxy / HTTPS_PROXY is set.
#
# Priority order (first non-empty wins):
#   AUTOUPGRADE_PROXY > https_proxy > HTTPS_PROXY > http_proxy > HTTP_PROXY
#
# Credentials in the URL are stripped with a warning; Java does not use them
# for HTTPS tunneling.
#
#AUTOUPGRADE_PROXY=http://proxy.example.com:3128
#https_proxy=http://proxy.example.com:3128

# Comma-separated list of hosts that bypass the proxy.
# Leading dots are converted to wildcards: .example.com -> *.example.com
# CIDR entries (e.g. 10.0.0.0/8) are skipped with a warning (unsupported by Java).
#
#no_proxy=localhost,127.0.0.1,.example.com

# ------------------------------------------------------------------------------
# Truststore settings
# ------------------------------------------------------------------------------
# Path to the Java truststore (JKS format) to use for TLS verification.
# Use "none" to keep the JDK bundled cacerts (Oracle Home JDK default).
# If not set, the wrapper checks the following paths and uses the first readable:
#   /etc/pki/ca-trust/extracted/java/cacerts   (OL / RHEL)
#   /etc/ssl/certs/java/cacerts                (Debian / Ubuntu / SLES)
#
#AUTOUPGRADE_TRUSTSTORE=/etc/pki/ca-trust/extracted/java/cacerts
#AUTOUPGRADE_TRUSTSTORE=none

# Truststore password. Only needed when AUTOUPGRADE_TRUSTSTORE is set.
# Default is the JDK standard password. Never echo this value in scripts.
#
#AUTOUPGRADE_TRUSTSTORE_PASS=changeit

# ------------------------------------------------------------------------------
# Java settings
# ------------------------------------------------------------------------------
# Absolute path to the JDK home to use for AutoUpgrade.
# Default resolution order:
#   AUTOUPGRADE_JAVA_HOME > $ORACLE_HOME/jdk/bin/java > PATH java
# Use this when the system default Java differs from the one needed for
# AutoUpgrade (e.g. when ORACLE_HOME is the DB being upgraded).
#
#AUTOUPGRADE_JAVA_HOME=/u00/app/oracle/product/19.32.0.0/jdk

# Supported Java major versions (space-separated).
# Java 8 and 11 are confirmed. Extend after verifying support for 17 / 21;
# see doc/proxy-and-truststore.md for the research outcome.
#
#AUTOUPGRADE_JAVA_SUPPORTED="8 11"

# ------------------------------------------------------------------------------
# JVM options
# ------------------------------------------------------------------------------
# Additional JVM options passed to java before -jar (word-split on spaces).
# Example: memory limit, garbage collector override.
#
#AUTOUPGRADE_JAVA_OPTS="-Xmx2g"

# Enable SSL/TLS handshake debug output (true / false).
# Useful when diagnosing certificate or proxy CONNECT failures.
#
#AUTOUPGRADE_DEBUG_SSL=false

# ------------------------------------------------------------------------------
# Dry-run mode
# ------------------------------------------------------------------------------
# Print the full java command line (with truststore password masked) and exit 0
# without running AutoUpgrade. Useful for verifying proxy and truststore config.
#
#AUTOUPGRADE_DRY_RUN=false
